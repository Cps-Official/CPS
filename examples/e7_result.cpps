++ divide <~ (a: int, b: int) -> Result<int, string> ** {
    ?? b == 0 ** {
        <- Err("div by zero")
    }
    <- Ok(a / b)
}

result := divide(10, 2)
?~ result {
    Ok(value) => { ~> io::println("Result: {}", value) },
    Err(err) => { ~> io::println("Error: {}", err) }
}

result2 := divide(10, 0)
?~ result2 {
    Ok(value) => { ~> io::println("Result: {}", value) },
    Err(err) => { ~> io::println("Error: {}", err) }
}
